# =============================================================================
# AuraFit environment template
# -----------------------------------------------------------------------------
# Copy to `.env.local` (web: apps/web/.env.local, or the repo root for tooling)
# and fill in real values. Never commit real secrets — `.env*` is gitignored
# except for this file.
#
# Notes
# - NODE_ENV is set by the tooling (`next dev` / `next build` / Docker); do not
#   set it here.
# - NEXT_PUBLIC_* and EXPO_PUBLIC_* values are inlined into client bundles at
#   BUILD time and are visible to anyone. Never put secrets in them.
# - Every variable below is OPTIONAL: without them the web app runs in local
#   demo mode. They are required only to enable the related integration.
# =============================================================================

# --- Web platform ------------------------------------------------------------
# Public canonical URL of the web app (metadata; fallback origin for auth
# redirect URLs when the request has no Origin/Host). Default https://aurafit.app.
NEXT_PUBLIC_APP_URL=

# --- Database & auth (Supabase) ---------------------------------------------
# Optional. Without these the web app still runs: /login shows an
# "accounts not configured" notice, the local demo lives at /demo, and
# /api/v1/* answers 401 (no credentials) or 503 NOT_CONFIGURED.
# NEXT_PUBLIC_* values are inlined at BUILD time — rebuild after changing them.
#
# Project URL (Dashboard → Project Settings → API / Connect).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Safe for browsers; data is protected by
# RLS. The legacy anon JWT also works here (or via NEXT_PUBLIC_SUPABASE_ANON_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. SECRET (sb_secret_…, or the legacy service_role JWT via
# SUPABASE_SERVICE_ROLE_KEY). Bypasses Row Level Security — used only by
# server code (apps/web/src/lib/supabase/admin.ts, guarded by `server-only`).
# Never prefix with NEXT_PUBLIC_ and never ship it to the mobile app.
SUPABASE_SECRET_KEY=
# Optional, for tooling only (psql / migrations). Not read by the app.
# postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=

# --- Mobile (Expo) -----------------------------------------------------------
# Base URL of the web API the mobile app syncs against.
# Optional. Example: https://aurafit.app/api
EXPO_PUBLIC_API_URL=
# EAS project ID (from `eas init` / expo.dev). Optional for local dev,
# required for EAS Build/Update and push notifications.
EXPO_PUBLIC_PROJECT_ID=

# --- Analytics & monitoring --------------------------------------------------
# Optional. PostHog project key (public).
NEXT_PUBLIC_POSTHOG_KEY=
# Optional. Sentry DSN for server/client error reporting.
SENTRY_DSN=
