# =============================================================================
# AuraFit environment template
# -----------------------------------------------------------------------------
# Copy to `.env.local` (web: apps/web/.env.local, or the repo root for tooling)
# and fill in real values. Never commit real secrets — `.env*` is gitignored
# except for this file.
#
# Notes
# - NODE_ENV is set by the tooling (`next dev` / `next build` / Docker); do not
#   set it here.
# - NEXT_PUBLIC_* and EXPO_PUBLIC_* values are inlined into client bundles at
#   BUILD time and are visible to anyone. Never put secrets in them.
# - Every variable below is currently OPTIONAL: the app runs fully offline /
#   local-first without them. They are required only to enable the related
#   integration.
# =============================================================================

# --- Web platform ------------------------------------------------------------
# Public canonical URL of the web app. Optional; reserved for deployment
# config (metadata currently defaults to https://aurafit.app).
NEXT_PUBLIC_APP_URL=

# --- Database & auth (Supabase / PostgreSQL) ---------------------------------
# Optional. When any of DATABASE_URL / SUPABASE_URL / NEXT_PUBLIC_SUPABASE_URL
# is set, /api/health reports the database as "configured".
#
# Public project URL and anon key (safe for the browser; protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. SECRET — bypasses Row Level Security. Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. SECRET — direct Postgres connection string, e.g.
# postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# Schema: packages/shared/schema.sql
DATABASE_URL=

# --- Mobile (Expo) -----------------------------------------------------------
# Base URL of the web API the mobile app syncs against.
# Optional. Example: https://aurafit.app/api
EXPO_PUBLIC_API_URL=
# EAS project ID (from `eas init` / expo.dev). Optional for local dev,
# required for EAS Build/Update and push notifications.
EXPO_PUBLIC_PROJECT_ID=

# --- Analytics & monitoring --------------------------------------------------
# Optional. PostHog project key (public).
NEXT_PUBLIC_POSTHOG_KEY=
# Optional. Sentry DSN for server/client error reporting.
SENTRY_DSN=
