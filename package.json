{
  "name": "aurafit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AuraFit — Gen Z & Gen Alpha Fitness Platform with Expo SDK 57 & Next.js PWA",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:web": "npm run build --workspace=apps/web",
    "build:shared": "npm run build --workspace=packages/shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:shared && npm run typecheck:web && npm run typecheck:mobile",
    "typecheck:shared": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/shared/test/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:mobile": "tsc --noEmit -p apps/mobile/tsconfig.json"
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "keywords": [
    "fitness",
    "genz",
    "genalpha",
    "expo",
    "react-native",
    "nextjs",
    "pwa",
    "gamification",
    "solo-leveling"
  ],
  "author": "AuraFit Team",
  "license": "MIT",
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
