# AuraFit mobile — copy to apps/mobile/.env (git-ignored).
# EXPO_PUBLIC_* values are inlined into the app bundle: they are PUBLIC. Never put a
# service_role / sb_secret_ key here (the app refuses to use one and falls back to demo mode).
#
# If any of the three values below is missing, the app runs in "Demo mode" (local seed data).

EXPO_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy anon key also works, via either this
# variable or EXPO_PUBLIC_SUPABASE_ANON_KEY.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# AuraFit web API origin (Next.js). On a physical device / Android emulator, localhost is the
# device itself — use your machine's LAN IP (or 10.0.2.2 on the Android emulator).
EXPO_PUBLIC_API_URL=

# Optional: show "Continue with Google" (requires the Google provider in Supabase Auth).
# EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=true

# Supabase dashboard → Auth → URL Configuration → Redirect URLs must include:
#   aurafit://**          (dev/prod builds)
#   exp://**              (Expo Go, development only)
